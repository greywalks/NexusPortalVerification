component output=false {
    function init(required string datasource, required string rootPath, required any excelService){
        variables.datasource=arguments.datasource;
        variables.rootPath=arguments.rootPath;
        variables.excel=arguments.excelService;
        variables.dataPath=arguments.rootPath&"data/inventory-management/";
        variables.uploadPath=variables.dataPath&"uploads/";
        variables.referencePath=variables.dataPath&"promethean_reference.json";
        if(!directoryExists(variables.uploadPath))directoryCreate(variables.uploadPath,true);
        return this;
    }

    void function bootstrap(){
        var sql=[
            "CREATE TABLE IF NOT EXISTS inventory_import_batches (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, source_name VARCHAR(500) NOT NULL, original_filename VARCHAR(1000) NOT NULL, stored_filename VARCHAR(1200) NOT NULL, file_hash VARCHAR(128) NOT NULL UNIQUE, imported_at TIMESTAMP NOT NULL, rows_read INT NOT NULL DEFAULT 0, events_added INT NOT NULL DEFAULT 0, duplicates_skipped INT NOT NULL DEFAULT 0, warnings_json CLOB NOT NULL DEFAULT '[]')",
            "CREATE TABLE IF NOT EXISTS inventory_assets (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, serial_number VARCHAR(500) NOT NULL, normalized_serial VARCHAR(500) NOT NULL UNIQUE, last_model VARCHAR(500), updated_at TIMESTAMP NOT NULL)",
            "CREATE TABLE IF NOT EXISTS inventory_cases (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, mso_number VARCHAR(500) NOT NULL, normalized_mso VARCHAR(500) NOT NULL UNIQUE, case_number VARCHAR(500))",
            "CREATE TABLE IF NOT EXISTS inventory_events (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, asset_id BIGINT, case_id BIGINT, event_type VARCHAR(120) NOT NULL, event_at TIMESTAMP, model_number VARCHAR(500), source_type VARCHAR(120) NOT NULL, batch_id BIGINT NOT NULL, source_row_key VARCHAR(1000) NOT NULL, fingerprint VARCHAR(128) NOT NULL UNIQUE, details_json CLOB NOT NULL DEFAULT '{}', CONSTRAINT fk_inv_asset FOREIGN KEY(asset_id) REFERENCES inventory_assets(id), CONSTRAINT fk_inv_case FOREIGN KEY(case_id) REFERENCES inventory_cases(id), CONSTRAINT fk_inv_batch FOREIGN KEY(batch_id) REFERENCES inventory_import_batches(id) ON DELETE CASCADE)",
            "CREATE TABLE IF NOT EXISTS promethean_model_overrides (normalized_serial VARCHAR(500) PRIMARY KEY, serial_number VARCHAR(500) NOT NULL, approved_model VARCHAR(500) NOT NULL, note VARCHAR(2000), created_at TIMESTAMP NOT NULL, updated_at TIMESTAMP NOT NULL)",
            "CREATE TABLE IF NOT EXISTS promethean_whitelist (kind VARCHAR(20) NOT NULL, normalized_value VARCHAR(500) NOT NULL, display_value VARCHAR(500) NOT NULL, note VARCHAR(2000), created_at TIMESTAMP NOT NULL, updated_at TIMESTAMP NOT NULL, PRIMARY KEY(kind,normalized_value))",
            "CREATE INDEX IF NOT EXISTS idx_inv_assets_serial ON inventory_assets(normalized_serial)",
            "CREATE INDEX IF NOT EXISTS idx_inv_cases_mso ON inventory_cases(normalized_mso)",
            "CREATE INDEX IF NOT EXISTS idx_inv_events_asset ON inventory_events(asset_id,event_at)",
            "CREATE INDEX IF NOT EXISTS idx_inv_events_case ON inventory_events(case_id,event_at)",
            "CREATE INDEX IF NOT EXISTS idx_inv_events_model ON inventory_events(model_number)",
            "CREATE INDEX IF NOT EXISTS idx_inv_events_type ON inventory_events(event_type)",
            "CREATE INDEX IF NOT EXISTS idx_inv_events_date ON inventory_events(event_at)"
        ];
        for(var stmt in sql)queryExecute(stmt,{}, {datasource:variables.datasource});
    }

    struct function dashboard(){
        return {
            assets:scalar("SELECT COUNT(*) FROM inventory_assets"),events:scalar("SELECT COUNT(*) FROM inventory_events"),
            cases:scalar("SELECT COUNT(*) FROM inventory_cases"),imports:scalar("SELECT COUNT(*) FROM inventory_import_batches"),
            latest:toArray(queryExecute("SELECT * FROM inventory_import_batches ORDER BY id DESC LIMIT 5",{}, {datasource:variables.datasource}))
        };
    }

    struct function search(required string query,string kind="auto"){
        var q=clean(arguments.query);var k=lCase(clean(arguments.kind));if(!len(q))return {kind:"",value:""};
        if(k=="auto"||k=="serial"){
            var s=queryExecute("SELECT serial_number FROM inventory_assets WHERE normalized_serial=:q",{q:norm(q)},{datasource:variables.datasource});
            if(s.recordCount)return {kind:"serial",value:s.serial_number[1]};
        }
        if(k=="auto"||k=="mso"){
            var m=queryExecute("SELECT mso_number FROM inventory_cases WHERE normalized_mso=:q",{q:normalizeMso(q)},{datasource:variables.datasource});
            if(m.recordCount)return {kind:"mso",value:m.mso_number[1]};
        }
        return {kind:"model",value:q};
    }

    struct function serialDetail(required string serial){
        var q=queryExecute("SELECT * FROM inventory_assets WHERE normalized_serial=:s",{s:norm(arguments.serial)},{datasource:variables.datasource});
        if(!q.recordCount)return{};
        var out=row(q,1);out.events=eventRows("e.asset_id=:id",{id:out.id});out.models=[];out.msos=[];out.inventory={};
        for(var e in out.events){if(len(e.model_number?:"")&&!arrayFindNoCase(out.models,e.model_number))arrayAppend(out.models,e.model_number);if(len(e.mso_number?:"")&&!arrayFindNoCase(out.msos,e.mso_number))arrayAppend(out.msos,e.mso_number);if(e.event_type=="inventory_observed")out.inventory=e;}
        return out;
    }

    struct function msoDetail(required string mso){
        var q=queryExecute("SELECT * FROM inventory_cases WHERE normalized_mso=:m",{m:normalizeMso(arguments.mso)},{datasource:variables.datasource});if(!q.recordCount)return{};
        var out=row(q,1);out.events=eventRows("e.case_id=:id",{id:out.id});out.serials=[];for(var e in out.events)if(len(e.serial_number?:"")&&!arrayFindNoCase(out.serials,e.serial_number))arrayAppend(out.serials,e.serial_number);return out;
    }

    struct function modelDetail(required string model){
        var rows=eventRows("UPPER(COALESCE(e.model_number,'')) LIKE :m",{m:"%"&uCase(clean(arguments.model))&"%"});return {model:arguments.model,total:arrayLen(rows),events:rows};
    }

    array function imports(numeric limit=250){return toArray(queryExecute("SELECT * FROM inventory_import_batches ORDER BY id DESC LIMIT :n",{n:{value:arguments.limit,cfsqltype:"cf_sql_integer"}},{datasource:variables.datasource}));}

    struct function importFile(required string path,required string originalFilename){
        var original=safeName(arguments.originalFilename);var ext=lCase(listLast(original,"."));if(!listFindNoCase("csv,xlsx,xlsm",ext))throw(type="Logicore.Inventory",message="Unsupported file type: ."&ext);
        var bytes=fileReadBinary(arguments.path);if(!len(bytes))throw(type="Logicore.Inventory",message=original&" is empty.");
        var digest=lCase(hash(bytes,"SHA-256"));var exists=queryExecute("SELECT * FROM inventory_import_batches WHERE file_hash=:h",{h:digest},{datasource:variables.datasource});
        if(exists.recordCount)return {filename:original,duplicate_file:true,rows:exists.rows_read[1],events:0,skipped:exists.events_added[1]};
        var stored=dateFormat(now(),"yyyymmdd")&"_"&timeFormat(now(),"HHmmss")&"_"&left(replace(createUUID(),"-","","all"),8)&"_"&original;
        fileCopy(arguments.path,variables.uploadPath&stored);var imported=now();
        queryExecute("INSERT INTO inventory_import_batches(source_name,original_filename,stored_filename,file_hash,imported_at) VALUES('pending',:o,:s,:h,:at)",{o:original,s:stored,h:digest,at:{value:imported,cfsqltype:"cf_sql_timestamp"}},{datasource:variables.datasource});
        var bq=queryExecute("SELECT id FROM inventory_import_batches WHERE file_hash=:h",{h:digest},{datasource:variables.datasource});var batchId=bq.id[1];
        var rowsRead=0;var eventsAdded=0;var sources=[];
        try{
            var groups=ext=="csv"?csvGroups(arguments.path):excelGroups(arguments.path);
            for(var group in groups){if(!arrayFindNoCase(sources,group.kind))arrayAppend(sources,group.kind);var rn=2;for(var rec in group.rows){rowsRead++;eventsAdded+=importRecord(batchId,group.kind,group.sheet&":"&rn,rec,imported);rn++;}}
            if(!arrayLen(sources))throw(type="Logicore.Inventory",message="No supported data was found.");
            queryExecute("UPDATE inventory_import_batches SET source_name=:s,rows_read=:r,events_added=:e,duplicates_skipped=:d WHERE id=:id",{s:arrayToList(sources,", "),r:rowsRead,e:eventsAdded,d:max(0,rowsRead-eventsAdded),id:batchId},{datasource:variables.datasource});
        }catch(any e){queryExecute("DELETE FROM inventory_import_batches WHERE id=:id",{id:batchId},{datasource:variables.datasource});try{fileDelete(variables.uploadPath&stored);}catch(any ignored){}rethrow;}
        return {filename:original,duplicate_file:false,source:arrayToList(sources,", "),rows:rowsRead,events:eventsAdded};
    }

    struct function shippingRange(string preset="last7",string start="",string end=""){
        var p=lCase(arguments.preset);if(!listFindNoCase("today,yesterday,last7,last30,custom",p))p="last7";var today=dateFormat(now(),"yyyy-mm-dd");var s="";var e=today;
        if(p=="today")s=today;else if(p=="yesterday"){s=dateFormat(dateAdd("d",-1,now()),"yyyy-mm-dd");e=s;}else if(p=="last30")s=dateFormat(dateAdd("d",-29,now()),"yyyy-mm-dd");else if(p=="custom"&&isDate(arguments.start)&&isDate(arguments.end)){s=dateFormat(arguments.start,"yyyy-mm-dd");e=dateFormat(arguments.end,"yyyy-mm-dd");if(s>e){var t=s;s=e;e=t;}}else{s=dateFormat(dateAdd("d",-6,now()),"yyyy-mm-dd");p="last7";}
        return {preset:p,start:s,end:e,start_display:dateFormat(s,"mmm d, yyyy"),end_display:dateFormat(e,"mmm d, yyyy")};
    }

    struct function shippingHistory(required struct range,string model=""){
        var sql="e.source_type='shipping' AND e.event_type='shipped' AND e.event_at IS NOT NULL AND CAST(e.event_at AS DATE) BETWEEN :s AND :e";var params={s:arguments.range.start,e:arguments.range.end};
        if(len(trim(arguments.model))){sql&=" AND UPPER(TRIM(COALESCE(e.model_number,'')))=UPPER(TRIM(:model))";params.model=trim(arguments.model);}
        var rows=eventRows(sql,params,"DESC");var models={};var serials={};var msos={};for(var r in rows){if(len(r.model_number?:""))models[uCase(trim(r.model_number))]=1;if(len(r.serial_number?:""))serials[uCase(trim(r.serial_number))]=1;if(len(r.mso_number?:""))msos[uCase(trim(r.mso_number))]=1;}
        return {rows:rows,summary:{shipments:arrayLen(rows),models:structCount(models),serials:structCount(serials),msos:structCount(msos)}};
    }

    array function shippingModels(){var q=queryExecute("SELECT DISTINCT TRIM(model_number) model FROM inventory_events WHERE source_type='shipping' AND event_type='shipped' AND model_number IS NOT NULL AND TRIM(model_number)<>'' ORDER BY UPPER(TRIM(model_number))",{}, {datasource:variables.datasource});var a=[];for(var r in q)arrayAppend(a,r.model);return a;}

    string function modelCsv(required string model){return eventsCsv(modelDetail(arguments.model).events);}
    string function shippingCsv(required array rows){var out='"Shipped Date","Model","Serial Number","MSO","Case Number","Tracking Number","Sales Order Number","Pickup Date","Source File"'&chr(13)&chr(10);for(var r in arguments.rows){var d=r.details?:{};out&=csvLine([r.event_at?:"",r.model_number?:"",r.serial_number?:"",r.mso_number?:"",r.case_number?:"",d.tracking_number?:"",d.sales_order_number?:"",d.pickup_date?:"",r.original_filename?:""]);}return out;}

    string function shippingXlsx(required array rows,required struct range,string title="Shipping History",string model=""){
        var data=[];for(var r in arguments.rows){var d=r.details?:{};arrayAppend(data,{"Shipped Date":r.event_at?:"","Model":r.model_number?:"","Serial Number":r.serial_number?:"","MSO":r.mso_number?:"","Case Number":r.case_number?:"","Tracking Number":d.tracking_number?:"","Sales Order Number":d.sales_order_number?:"","Pickup Date":d.pickup_date?:"","Source File":r.original_filename?:""});}
        var name="Shipping_History_"&(len(arguments.model)?safeName(arguments.model):"All_Models")&"_"&arguments.range.start&"_to_"&arguments.range.end&".xlsx";variables.excel.writeWorkbook(variables.rootPath&"outputs/"&name,[{name:"Shipping History",headers:["Shipped Date","Model","Serial Number","MSO","Case Number","Tracking Number","Sales Order Number","Pickup Date","Source File"],rows:data}]);return name;
    }

    boolean function installReference(required string path){var data=deserializeJson(fileRead(arguments.path,"utf-8"));if(!isStruct(data)||!isStruct(data.models?:0)||!structCount(data.models)||!isStruct(data.part_models?:0)||!structCount(data.part_models)||!isStruct(data.serial_rules?:0))throw(type="Logicore.Inventory",message="Reference file is missing required model, part, or serial maps.");fileCopy(arguments.path,variables.referencePath);return true;}
    struct function reference(){if(!fileExists(variables.referencePath))return{};try{return deserializeJson(fileRead(variables.referencePath,"utf-8"));}catch(any e){return{};}}

    struct function manualQuality(string serial="",string model="",string part=""){
        var ref=reference();var out={};if(!structCount(ref))return out;if(len(trim(arguments.serial))&&len(trim(arguments.model)))out.model=checkModel(arguments.serial,arguments.model,ref);else if(len(trim(arguments.serial)))out.serial_only=decodeSerial(arguments.serial,ref);if(len(trim(arguments.part)))out.part=checkPart(arguments.part,arguments.serial,arguments.model,ref);return out;
    }

    void function saveOverride(required string serial,required string approvedModel,string note=""){
        var n=norm(arguments.serial);var nowv=now();queryExecute("MERGE INTO promethean_model_overrides(normalized_serial,serial_number,approved_model,note,created_at,updated_at) KEY(normalized_serial) VALUES(:n,:s,:m,:note,COALESCE((SELECT created_at FROM promethean_model_overrides WHERE normalized_serial=:n2),:now1),:now2)",{n:n,s:clean(arguments.serial),m:clean(arguments.approvedModel),note:clean(arguments.note),n2:n,now1:nowv,now2:nowv},{datasource:variables.datasource});
    }
    void function deleteOverride(required string serial){queryExecute("DELETE FROM promethean_model_overrides WHERE normalized_serial=:s",{s:norm(arguments.serial)},{datasource:variables.datasource});}
    void function saveWhitelist(required string kind,required string value,string note=""){var k=lCase(clean(arguments.kind));if(!listFindNoCase("part,model",k))throw(type="Logicore.Inventory",message="Whitelist type must be part or model.");var n=k=="part"?canonicalPart(arguments.value):canonicalModel(arguments.value);var nowv=now();queryExecute("MERGE INTO promethean_whitelist(kind,normalized_value,display_value,note,created_at,updated_at) KEY(kind,normalized_value) VALUES(:k,:n,:v,:note,COALESCE((SELECT created_at FROM promethean_whitelist WHERE kind=:k2 AND normalized_value=:n2),:now1),:now2)",{k:k,n:n,v:clean(arguments.value),note:clean(arguments.note),k2:k,n2:n,now1:nowv,now2:nowv},{datasource:variables.datasource});}
    void function deleteWhitelist(required string kind,required string value){var k=lCase(clean(arguments.kind));var n=k=="part"?canonicalPart(arguments.value):canonicalModel(arguments.value);queryExecute("DELETE FROM promethean_whitelist WHERE kind=:k AND normalized_value=:n",{k:k,n:n},{datasource:variables.datasource});}

    struct function qualityAudit(){
        var ref=reference();if(!structCount(ref))return{};var b=queryExecute("SELECT * FROM inventory_import_batches WHERE LOWER(source_name) LIKE '%inventory%' ORDER BY id DESC LIMIT 1",{}, {datasource:variables.datasource});
        var overrides=toArray(queryExecute("SELECT * FROM promethean_model_overrides ORDER BY serial_number",{}, {datasource:variables.datasource}));var whitelistRows=toArray(queryExecute("SELECT * FROM promethean_whitelist ORDER BY kind,display_value",{}, {datasource:variables.datasource}));var whitelist={part:{},model:{}};for(var w in whitelistRows)whitelist[w.kind][w.normalized_value]=w;
        var audit={batch:b.recordCount?row(b,1):{},inventory_records:0,units_checked:0,recognized_parts:0,whitelisted_parts:0,whitelisted_models:0,issues:[],errors:0,warnings:0,unmatched:[],unmatched_count:0,overrides:overrides,whitelist:whitelist};if(!b.recordCount)return audit;
        var oq={};for(var o in overrides)oq[o.normalized_serial]=o;var rows=eventRows("e.batch_id=:b AND e.source_type='inventory' AND e.event_type='inventory_observed'",{b:b.id[1]});audit.inventory_records=arrayLen(rows);
        for(var item in rows){var serial=clean(item.serial_number?:"");var recorded=clean(item.model_number?:"");var grade=uCase(left(clean(item.details.grade?:""),1));var rcore=canonicalModel(recorded);var pkey=canonicalPart(recorded);if(structKeyExists(whitelist.part,pkey)){audit.whitelisted_parts++;continue;}var decoded=decodeSerial(serial,ref);var ov=oq[norm(serial)]?:{};var expected="";var source="";if(structCount(ov)){expected=canonicalModel(ov.approved_model);source="Approved serial mapping";}else if(structCount(decoded)){expected=canonicalModel(decoded.model);source="Serial decoder";}else if(structKeyExists(whitelist.model,rcore)){expected=canonicalModel(whitelist.model[rcore].display_value);source="Approved model whitelist";audit.whitelisted_models++;}
            var knownModel=partsModelKey(recorded,ref);var knownPart=structKeyExists(ref.part_models?:{},pkey);var isUnit=len(expected)||len(knownModel)||structKeyExists(whitelist.model,rcore);if(!len(expected)&&!len(knownModel)&&knownPart){audit.recognized_parts++;continue;}if(isUnit)audit.units_checked++;
            var expectedFull=expectedFullModel(len(expected)?expected:rcore,grade);
            if(len(expected)){if(!len(recorded))appendIssue(audit,item,"Missing model","error",expectedFull,source,"Inventory record has no model number.",grade);else if(rcore!=expected)appendIssue(audit,item,structCount(ov)?"Approved model mismatch":"Model mismatch","error",expectedFull,source,"Recorded model "&recorded&" does not match "&expectedFull&".",grade);}else if(!knownPart&&!structKeyExists(whitelist.model,rcore)){item.grade=grade;item.message=len(knownModel)?"Model is recognized, but this serial format cannot be decoded. Approve the model globally or map this serial specifically.":"Recorded value is not recognized as a panel model or part number, and the serial cannot be decoded. Approve it as a part/value or model if it is valid.";arrayAppend(audit.unmatched,item);continue;}
            if(isUnit&&len(expectedFull)){var normalizedRecorded=normalizeToken(recorded);if((grade=="B"||grade=="R")&&normalizedRecorded!=normalizeToken(expectedFull)&&rcore==(len(expected)?expected:rcore))appendIssue(audit,item,grade&"-grade suffix","error",expectedFull,"Grade rule",grade&"-grade inventory units must use the full model ending -NA-R.",grade);else if(grade=="A"&&normalizedRecorded!=normalizeToken(expectedFull)&&rcore==(len(expected)?expected:rcore))appendIssue(audit,item,"A-grade suffix","warning",expectedFull,"Grade rule","A-stock units normally use the full model ending -NA.",grade);}
        }
        audit.errors=arrayLen(arrayFilter(audit.issues,function(x){return x.severity=="error";}));audit.warnings=arrayLen(arrayFilter(audit.issues,function(x){return x.severity=="warning";}));audit.unmatched_count=arrayLen(audit.unmatched);return audit;
    }

    string function qualityCsv(required struct audit){var out='"Record Type","Issue Type","Severity","Serial Number","Grade","Recorded Model","Expected / Approved Model","Warehouse","Rack","Bin","Source File","Source Row","Detail"'&chr(13)&chr(10);for(var i in arguments.audit.issues)out&=csvLine(["Issue",i.issue_type,i.severity,i.serial_number?:"",i.grade?:"",i.model_number?:"",i.expected_model?:"",i.details.warehouse?:"",i.details.rack?:"",i.details.bin?:"",i.original_filename?:"",i.source_row_key?:"",i.message?:""]);for(var i in arguments.audit.unmatched)out&=csvLine(["Needs model mapping","Unmatched serial/model","review",i.serial_number?:"",i.grade?:"",i.model_number?:"","",i.details.warehouse?:"",i.details.rack?:"",i.details.bin?:"",i.original_filename?:"",i.source_row_key?:"",i.message?:""]);return out;}

    private numeric function importRecord(required numeric batchId,required string kind,required string rowKey,required struct r,required any observedAt){var added=0;var k=arguments.kind;var d={};
        if(k=="receiving"){d={grade:v(r,"Grade"),item_type:v(r,"Item Type"),rma_in_tracking:v(r,"RMA In Tracking"),pgr_tracking:v(r,"Receive Pallet / PGR Tracking")};added+=addEvent(batchId,k,rowKey,"received",asDate(v(r,"Received Date")),v(r,"Serial Number"),len(v(r,"RMA In Tracking"))?v(r,"RMA In Tracking"):v(r,"Receive Pallet / PGR Tracking"),v(r,"Model"),"",d);}
        else if(k=="shipping"){d={tracking_number:v(r,"Tracking Number"),sales_order_number:v(r,"Sales Order Number"),pickup_date:v(r,"Pickup Date")};added+=addEvent(batchId,k,rowKey,"shipped",asDate(v(r,"Shipped Date")),v(r,"Serial Number"),v(r,"Ticket Number"),v(r,"Model"),"",d);if(len(v(r,"Pickup Date")))added+=addEvent(batchId,k,rowKey,"picked_up",asDate(v(r,"Pickup Date")),v(r,"Serial Number"),v(r,"Ticket Number"),v(r,"Model"),"",{tracking_number:v(r,"Tracking Number")});}
        else if(k=="inventory"){d={transfer_detail_id:v(r,"Transfer Detail ID"),grade:v(r,"Grade"),rack:v(r,"Rack"),bin:v(r,"Bin"),warehouse:v(r,"Warehouse"),item_type:v(r,"Item Type"),source_received_date:v(r,"Received Date")};added+=addEvent(batchId,k,rowKey,"inventory_observed",observedAt,v(r,"Serial Number"),"",v(r,"Model"),"",d);}
        else if(k=="repair"){var result=clean(v(r,"Result"));var rl=lCase(result);var et=find("pending",rl)&&find("part",rl)?"repair_pending_parts":(find("scrap",rl)?"repair_scrapped":"repair");d={box_model:v(r,"Box Model"),box_serial:v(r,"Box Serial"),result:result,category:v(r,"Category"),most_recent_ship_date:v(r,"Most Recent Ship Date Per Serial")};added+=addEvent(batchId,k,rowKey,et,asDate(v(r,"Timestamp")),len(v(r,"Actual Serial"))?v(r,"Actual Serial"):v(r,"Box Serial"),"",len(v(r,"Actual Model"))?v(r,"Actual Model"):v(r,"Box Model"),"",d);}
        else if(k=="fedex"){var serial=len(v(r,"Serial Number"))?v(r,"Serial Number"):v(r,"Used Serial Number");var mso=v(r,"MSO");var caseNo=v(r,"Case Number");var model=len(v(r,"Part/Component Reported Product Code"))?v(r,"Part/Component Reported Product Code"):v(r,"Part/Component Used Product Code");var base={case_number:caseNo,reported_product_code:v(r,"Part/Component Reported Product Code"),used_product_code:v(r,"Part/Component Used Product Code"),used_serial_number:v(r,"Used Serial Number"),quantity:v(r,"Quantity"),service_company:v(r,"Service Company"),outbound_tracking:v(r,"Outbound Tracking"),return_tracking:v(r,"Return Tracking")};if(len(v(r,"Request Date")))added+=addEvent(batchId,k,rowKey,"fedex_requested",asDate(v(r,"Request Date")),serial,mso,model,caseNo,base);if(len(v(r,"Outbound Tracking"))&&!len(v(r,"Fedex Ship Date")))added+=addEvent(batchId,k,rowKey,"fedex_outbound_created",asDate(v(r,"Request Date")),serial,mso,model,caseNo,base);if(len(v(r,"Fedex Ship Date")))added+=addEvent(batchId,k,rowKey,"fedex_outbound_shipped",asDate(v(r,"Fedex Ship Date")),serial,mso,model,caseNo,merged(base,{outbound_status:v(r,"Outbound Status")}));if(len(v(r,"Outbound Delivery Date")))added+=addEvent(batchId,k,rowKey,"fedex_outbound_delivered",asDate(v(r,"Outbound Delivery Date")),serial,mso,model,caseNo,merged(base,{outbound_status:v(r,"Outbound Status")}));if(len(v(r,"Return Tracking")))added+=addEvent(batchId,k,rowKey,"fedex_return_created",asDate(v(r,"Request Date")),serial,mso,model,caseNo,base);if(len(v(r,"Return Tracking Ship Date")))added+=addEvent(batchId,k,rowKey,"fedex_return_shipped",asDate(v(r,"Return Tracking Ship Date")),serial,mso,model,caseNo,merged(base,{return_status:v(r,"Return Status")}));if(len(v(r,"Return Tracking Delivery Date")))added+=addEvent(batchId,k,rowKey,"fedex_return_delivered",asDate(v(r,"Return Tracking Delivery Date")),serial,mso,model,caseNo,merged(base,{return_status:v(r,"Return Status")}));}
        return added;}

    private struct function merged(required struct source,required struct extra){var result=duplicate(source);structAppend(result,extra,true);return result;}
    private numeric function addEvent(required numeric batchId,required string sourceType,required string rowKey,required string eventType,any eventAt="",string serial="",string mso="",string model="",string caseNumber="",struct details={}){if(!len(clean(serial))&&!len(clean(mso))&&!len(clean(model)))return 0;var aid=len(clean(serial))?assetId(serial,model):javacast("null","");var cid=len(clean(mso))?caseId(mso,caseNumber):javacast("null","");var fp=eventFingerprint(sourceType,eventType,serial,mso,eventAt,model,details);var exists=queryExecute("SELECT id FROM inventory_events WHERE fingerprint=:f",{f:fp},{datasource:variables.datasource});if(exists.recordCount)return 0;queryExecute("INSERT INTO inventory_events(asset_id,case_id,event_type,event_at,model_number,source_type,batch_id,source_row_key,fingerprint,details_json) VALUES(:a,:c,:et,:at,:m,:st,:b,:rk,:f,:d)",{a:{value:isNull(aid)?"":aid,null:isNull(aid)},c:{value:isNull(cid)?"":cid,null:isNull(cid)},et:eventType,at:{value:eventAt,null:!isDate(eventAt),cfsqltype:"cf_sql_timestamp"},m:{value:clean(model),null:!len(clean(model))},st:sourceType,b:batchId,rk:rowKey,f:fp,d:serializeJson(details)},{datasource:variables.datasource});return 1;}
    private numeric function assetId(required string serial,string model=""){var n=norm(serial);var q=queryExecute("SELECT id FROM inventory_assets WHERE normalized_serial=:n",{n:n},{datasource:variables.datasource});if(q.recordCount){if(len(clean(model)))queryExecute("UPDATE inventory_assets SET last_model=:m,updated_at=CURRENT_TIMESTAMP WHERE id=:id",{m:clean(model),id:q.id[1]},{datasource:variables.datasource});return q.id[1];}queryExecute("INSERT INTO inventory_assets(serial_number,normalized_serial,last_model,updated_at) VALUES(:s,:n,:m,CURRENT_TIMESTAMP)",{s:clean(serial),n:n,m:{value:clean(model),null:!len(clean(model))}},{datasource:variables.datasource});return queryExecute("SELECT id FROM inventory_assets WHERE normalized_serial=:n",{n:n},{datasource:variables.datasource}).id[1];}
    private numeric function caseId(required string mso,string caseNumber=""){var n=normalizeMso(mso);var q=queryExecute("SELECT id FROM inventory_cases WHERE normalized_mso=:n",{n:n},{datasource:variables.datasource});if(q.recordCount){if(len(clean(caseNumber)))queryExecute("UPDATE inventory_cases SET case_number=COALESCE(case_number,:c) WHERE id=:id",{c:clean(caseNumber),id:q.id[1]},{datasource:variables.datasource});return q.id[1];}queryExecute("INSERT INTO inventory_cases(mso_number,normalized_mso,case_number) VALUES(:m,:n,:c)",{m:n,n:n,c:{value:clean(caseNumber),null:!len(clean(caseNumber))}},{datasource:variables.datasource});return queryExecute("SELECT id FROM inventory_cases WHERE normalized_mso=:n",{n:n},{datasource:variables.datasource}).id[1];}

    private array function excelGroups(required string path){var groups=[];for(var sheet in variables.excel.sheetNames(arguments.path)){var rows=variables.excel.readSheet(arguments.path,sheet);if(!arrayLen(rows))continue;var kind=sourceKind(structKeyArray(rows[1]));if(len(kind))arrayAppend(groups,{kind:kind,sheet:sheet,rows:rows});}return groups;}
    private array function csvGroups(required string path){var text=fileRead(arguments.path,"utf-8");var matrix=parseCsv(text);if(arrayLen(matrix)<2)return[];var headers=matrix[1];var kind=sourceKind(headers);if(!len(kind))throw(type="Logicore.Inventory",message="CSV columns do not match a supported Receiving, Shipping, or Inventory export.");var rows=[];for(var i=2;i<=arrayLen(matrix);i++){var rec={};var nonblank=false;for(var c=1;c<=arrayLen(headers);c++){if(!len(clean(headers[c])))continue;rec[clean(headers[c])]=c<=arrayLen(matrix[i])?matrix[i][c]:"";if(len(clean(rec[clean(headers[c])])))nonblank=true;}if(nonblank)arrayAppend(rows,rec);}return[{kind:kind,sheet:getFileFromPath(path),rows:rows}];}
    private string function sourceKind(required array headers){var h={};for(var x in arguments.headers)h[clean(x)]=1;if(hasAll(h,["Received Date","Model","Serial Number","RMA In Tracking"]))return"receiving";if(hasAll(h,["Ticket Number","Shipped Date","Model","Serial Number","Tracking Number"]))return"shipping";if(hasAll(h,["Transfer Detail ID","Model","Serial Number","Rack","Warehouse"]))return"inventory";if(hasAll(h,["Timestamp","Actual Model","Actual Serial","Result"]))return"repair";if(hasAll(h,["MSO","Serial Number","Outbound Tracking","Request Date"]))return"fedex";return"";}
    private boolean function hasAll(required struct s,required array keys){for(var k in arguments.keys)if(!structKeyExists(arguments.s,k))return false;return true;}
    private array function parseCsv(required string text){var out=[];var rowv=[];var field="";var quoted=false;var i=1;while(i<=len(text)){var ch=mid(text,i,1);if(ch=='"'){if(quoted&&i<len(text)&&mid(text,i+1,1)=='"'){field&='"';i+=2;continue;}quoted=!quoted;i++;continue;}if(!quoted&&ch==","){arrayAppend(rowv,field);field="";i++;continue;}if(!quoted&&(ch==chr(10)||ch==chr(13))){if(ch==chr(13)&&i<len(text)&&mid(text,i+1,1)==chr(10))i++;arrayAppend(rowv,field);field="";if(arrayLen(rowv))arrayAppend(out,rowv);rowv=[];i++;continue;}field&=ch;i++;}if(len(field)||arrayLen(rowv)){arrayAppend(rowv,field);arrayAppend(out,rowv);}return out;}

    private array function eventRows(required string where,required struct params,string direction="ASC"){var q=queryExecute("SELECT e.*,a.serial_number,a.normalized_serial,c.mso_number,c.case_number,b.original_filename,b.imported_at FROM inventory_events e LEFT JOIN inventory_assets a ON a.id=e.asset_id LEFT JOIN inventory_cases c ON c.id=e.case_id JOIN inventory_import_batches b ON b.id=e.batch_id WHERE "&arguments.where&" ORDER BY COALESCE(e.event_at,b.imported_at) "&arguments.direction&",e.id "&arguments.direction,arguments.params,{datasource:variables.datasource});var a=toArray(q);for(var item in a){try{item.details=deserializeJson(item.details_json?:"{}");}catch(any e){item.details={};}structDelete(item,"details_json");}return a;}
    private string function eventsCsv(required array rows){var out='"Event Date","Event Type","Model","Serial Number","MSO","Source","Source File"'&chr(13)&chr(10);for(var e in arguments.rows)out&=csvLine([e.event_at?:"",e.event_type?:"",e.model_number?:"",e.serial_number?:"",e.mso_number?:"",e.source_type?:"",e.original_filename?:""]);return out;}
    private string function csvLine(required array vals){var p=[];for(var x in arguments.vals)arrayAppend(p,'"'&replace(x&"",'"','""',"all")&'"');return arrayToList(p,",")&chr(13)&chr(10);}
    private string function clean(any value=""){if(isNull(arguments.value))return"";var t=trim(arguments.value&"");var m=reFind('^="(.*)"$',t,1,true);if(m.len[1])t=mid(t,m.pos[2],m.len[2]);return trim(t);}
    private string function norm(any v=""){return uCase(reReplace(clean(arguments.v),"\s+","","all"));}
    private string function normalizeMso(any v=""){var n=norm(arguments.v);var m=reFind("^(M[0-9]+)R$",n,1,true);return m.len[1]?mid(n,m.pos[2],m.len[2]):n;}
    private string function normalizeToken(any v=""){var s=uCase(clean(arguments.v));s=replaceList(s,chr(8211)&","&chr(8212)&","&chr(8722),"-,-,-");s=reReplace(s,"\s+","","all");return reReplace(s,"^[. ,;:]+|[. ,;:]+$","","all");}
    private string function canonicalModel(any v=""){var m=normalizeToken(arguments.v);m=reReplace(m,"-(NA|US|EU|UK|CN|ANZ|APAC)-R$","","one");m=reReplace(m,"-R$","","one");return m;}
    private string function canonicalPart(any v=""){var p=normalizeToken(arguments.v);p=reReplace(p,"\([^)]*\)$","","one");return reReplace(p,"\.$","","one");}
    private string function partsModelKey(required string model,required struct ref){var current=canonicalModel(arguments.model);if(structKeyExists(ref.models,current))return current;var candidates=[current];if(right(current,2)=="-M")arrayAppend(candidates,left(current,len(current)-2));for(var c in duplicate(candidates)){if(left(c,4)=="AP9-"&&right(c,3)=="-02")arrayAppend(candidates,left(c,len(c)-3));if(left(c,4)=="AP9-"&&find("-02-",c))arrayAppend(candidates,replace(c,"-02-","-","one"));}for(var c in candidates)if(structKeyExists(ref.models,c))return c;return"";}
    private struct function decodeSerial(required string serial,required struct ref){var s=reReplace(uCase(clean(arguments.serial)),"[^A-Z0-9]","","all");if(len(s)<6)return{};var rules=ref.serial_rules?:{};var years=rules.year_codes?:{};var prefix=left(s,2);if(structKeyExists(rules.modern_prefixes?:{},prefix)){var pr=rules.modern_prefixes[prefix];var cfg=rules.modern?:{};var size=mid(s,val(cfg.size_start?:2)+1,val(cfg.size_end?:4)-val(cfg.size_start?:2));var yi=val(cfg.year_index?:5)+1;var mi=val(cfg.designation_index?:4)+1;var vi=val(cfg.variant_index?:9)+1;if(!reFind("^[0-9]{2}$",size)||len(s)<max(yi,max(vi,mi)))return{};var yearChar=mid(s,yi,1);var marker=mid(s,mi,1);var variant=mid(s,vi,1);var model=(pr.model_prefix?:"")&size;var kind=pr.kind?:"";if(kind=="ap9"&&reFind("^[A-Z]$",marker)&&asc(marker) >= asc("G"))model=insert02(model);if(kind=="ap9"&&variant==(cfg.variant_marker?:"V"))model&="-V";else if(arrayFindNoCase(cfg.mexico_markers?:["M","A"],variant))model&="-M";return{model:model,model_core:canonicalModel(model),year_code:yearChar,year:structKeyExists(years,yearChar)?years[yearChar]:"",family:pr.model_prefix?:"",confidence:"documented"};}
        var ap7=rules.ap7?:{};var us=val(ap7.u_signature_start?:2)+1;var ue=val(ap7.u_signature_end?:5)-val(ap7.u_signature_start?:2);var sig=mid(s,us,ue);if(arrayFindNoCase(ap7.u_signatures?:[],sig)){var size=left(s,2);if(!isNumeric(size))return{};var yc=mid(s,val(ap7.u_year_index?:5)+1,1);var yr=structKeyExists(years,yc)?years[yc]:"";var model="AP7-U"&size;if(isNumeric(yr)&&yr>=val(ap7.dash02_start_year?:2021))model&="-02";return{model:model,model_core:canonicalModel(model),year_code:yc,year:yr,family:"AP7-U",confidence:"documented"};}for(var signature in ap7.b_signatures?:{})if(left(s,len(signature))==signature){var yc=mid(s,val(ap7.b_year_index?:4)+1,1);var yr=structKeyExists(years,yc)?years[yc]:"";var model=ap7.b_signatures[signature];if(isNumeric(yr)&&yr>=val(ap7.dash02_start_year?:2021))model&="-02";return{model:model,model_core:canonicalModel(model),year_code:yc,year:yr,family:"AP7-B",confidence:"documented"};}return{};}
    private string function insert02(required string model){if(find("-02",model))return model;if(right(model,2)=="-M"||right(model,2)=="-V")return left(model,len(model)-2)&"-02"&right(model,2);return model&"-02";}
    private struct function checkModel(required string serial,required string recorded,required struct ref){var observed=canonicalModel(recorded);var dec=decodeSerial(serial,ref);if(!len(observed))return{status:"missing_model",message:"No recorded model number was supplied.",decoded:dec,recorded_core:observed};if(structCount(dec))return observed==canonicalModel(dec.model)?{status:"ok",message:"Recorded model agrees with the serial number.",decoded:dec,recorded_core:observed}:{status:"mismatch",message:"Serial decodes to "&dec.model&", not "&recorded&".",decoded:dec,recorded_core:observed};return len(partsModelKey(recorded,ref))?{status:"not_decoded",message:"Model is recognized, but this serial format is not covered by the documented decoder.",decoded:{},recorded_core:observed}:{status:"unknown_model",message:"Recorded value is not recognized as a Promethean panel model.",decoded:{},recorded_core:observed};}
    private struct function checkPart(required string part,string serial="",string recordedModel="",required struct ref){var p=canonicalPart(part);var dec=len(serial)?decodeSerial(serial,ref):{};var compatibility=structCount(dec)?dec.model:canonicalModel(recordedModel);var mk=len(compatibility)?partsModelKey(compatibility,ref):"";var known=structKeyExists(ref.part_models?:{},p)?ref.part_models[p]:[];if(!len(p))return{status:"missing_part",message:"No part number was supplied.",known_on:[],parts_model:mk};if(!arrayLen(known))return{status:"unknown_part",message:"Part number is not present in the installed Promethean parts reference.",known_on:[],parts_model:mk};if(!len(mk))return{status:"known_part",message:"Part number is recognized, but a compatible panel model could not be determined.",known_on:known,parts_model:""};return arrayFindNoCase(known,mk)?{status:"ok",message:"Part is listed for "&mk&".",known_on:known,parts_model:mk}:{status:"incompatible",message:"Part is not listed for "&mk&".",known_on:known,parts_model:mk};}
    private string function expectedFullModel(required string core,required string grade){if(!len(core))return"";if(grade=="B"||grade=="R")return core&"-NA-R";if(grade=="A")return core&"-NA";return core;}
    private void function appendIssue(required struct audit,required struct item,required string type,required string severity,required string expected,required string source,required string message,required string grade){var i=duplicate(item);i.issue_type=type;i.severity=severity;i.expected_model=expected;i.expectation_source=source;i.message=message;i.grade=grade;arrayAppend(audit.issues,i);}
    private string function eventFingerprint(required string source,required string type,string serial="",string mso="",any at="",string model="",struct details={}){var keys=structKeyArray(arguments.details);arraySort(keys,"textnocase");var bits=[source,type,norm(serial),normalizeMso(mso),isDate(at)?dateTimeFormat(at,"yyyy-mm-dd HH:nn:ss"):(at&""),norm(model)];for(var k in keys)if(len(clean(details[k])))arrayAppend(bits,k&"="&clean(details[k]));return lCase(hash(arrayToList(bits,"|"),"SHA-256"));}
    private any function asDate(any v=""){if(isDate(arguments.v))return parseDateTime(arguments.v);var s=clean(arguments.v);if(!len(s))return"";try{return parseDateTime(s);}catch(any e){return"";}}
    private any function v(required struct s,required string key){return structKeyExists(arguments.s,arguments.key)?arguments.s[arguments.key]:"";}
    private string function safeName(required string s){var x=reReplace(getFileFromPath(arguments.s),"[^A-Za-z0-9._ -]","_","all");return len(x)?x:"upload";}
    private numeric function scalar(required string sql){var q=queryExecute(arguments.sql,{}, {datasource:variables.datasource});var c=listFirst(q.columnList);return q[c][1];}
    private struct function row(required query q,required numeric n){var s={};for(var c in listToArray(q.columnList))s[lCase(c)]=q[c][n];return s;}
    private array function toArray(required query q){var a=[];for(var i=1;i<=q.recordCount;i++)arrayAppend(a,row(q,i));return a;}
}
