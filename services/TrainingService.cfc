component output=false {
    function init(required string datasource, required string rootPath){variables.datasource=arguments.datasource;variables.rootPath=arguments.rootPath;variables.uploadPath=arguments.rootPath&"data/training_signoffs/";if(!directoryExists(variables.uploadPath))directoryCreate(variables.uploadPath,true);return this;}
    void function init(){
        var sql=[
            "CREATE TABLE IF NOT EXISTS training_weeks (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, week_number INT NOT NULL, title VARCHAR(500) NOT NULL, start_date DATE, notes CLOB, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)",
            "CREATE TABLE IF NOT EXISTS training_topics (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, week_id BIGINT NOT NULL, title VARCHAR(500) NOT NULL, lesson_plan CLOB, key_points CLOB, sort_order INT DEFAULT 0, CONSTRAINT fk_topic_week FOREIGN KEY(week_id) REFERENCES training_weeks(id) ON DELETE CASCADE)",
            "CREATE TABLE IF NOT EXISTS training_videos (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, topic_id BIGINT NOT NULL, title VARCHAR(500), url VARCHAR(2000) NOT NULL, CONSTRAINT fk_video_topic FOREIGN KEY(topic_id) REFERENCES training_topics(id) ON DELETE CASCADE)",
            "CREATE TABLE IF NOT EXISTS training_people (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name VARCHAR(500) NOT NULL, email VARCHAR(500), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)",
            "CREATE TABLE IF NOT EXISTS training_sessions (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, week_id BIGINT NOT NULL, trainer_name VARCHAR(500) NOT NULL DEFAULT 'Unassigned', session_date DATE, location VARCHAR(500), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, CONSTRAINT fk_session_week FOREIGN KEY(week_id) REFERENCES training_weeks(id) ON DELETE CASCADE)",
            "CREATE TABLE IF NOT EXISTS training_attendance (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, session_id BIGINT NOT NULL, person_id BIGINT NOT NULL, attended INT DEFAULT 0, signature CLOB, signed_at TIMESTAMP, CONSTRAINT uq_training_att UNIQUE(session_id,person_id), CONSTRAINT fk_att_session FOREIGN KEY(session_id) REFERENCES training_sessions(id) ON DELETE CASCADE, CONSTRAINT fk_att_person FOREIGN KEY(person_id) REFERENCES training_people(id) ON DELETE CASCADE)",
            "CREATE TABLE IF NOT EXISTS training_content (key_name VARCHAR(255) PRIMARY KEY, value_text CLOB)",
            "CREATE TABLE IF NOT EXISTS training_theme (key_name VARCHAR(255) PRIMARY KEY, value_text VARCHAR(255))",
            "CREATE TABLE IF NOT EXISTS training_signoff_uploads (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, session_id BIGINT NOT NULL UNIQUE, filename VARCHAR(500) NOT NULL, original_filename VARCHAR(500), content_type VARCHAR(255), uploaded_by VARCHAR(120), uploaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, CONSTRAINT fk_sign_session FOREIGN KEY(session_id) REFERENCES training_sessions(id) ON DELETE CASCADE)"
        ];
        for(var stmt in sql)queryExecute(stmt,{}, {datasource:variables.datasource});
    }
    array function weeks(){var q=queryExecute("SELECT w.*, (SELECT COUNT(*) FROM training_topics t WHERE t.week_id=w.id) topic_count, (SELECT COUNT(*) FROM training_sessions s WHERE s.week_id=w.id) session_count FROM training_weeks w ORDER BY COALESCE(w.start_date,DATE '1900-01-01') DESC,w.week_number DESC",{}, {datasource:variables.datasource});return toArray(q);}
    struct function week(required numeric id){var q=queryExecute("SELECT * FROM training_weeks WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});if(!q.recordCount)return{};var w=row(q,1);w.topics=topics(id);w.sessions=sessions(id);return w;}
    numeric function createWeek(required string title,string startDate="",string notes=""){var n=queryExecute("SELECT COALESCE(MAX(week_number),0)+1 n FROM training_weeks",{}, {datasource:variables.datasource}).n[1];var r={};queryExecute("INSERT INTO training_weeks(week_number,title,start_date,notes) VALUES(:n,:t,:d,:notes)",{n:n,t:trim(arguments.title),d:{value:arguments.startDate,null:!len(arguments.startDate)},notes:arguments.notes},{datasource:variables.datasource,result:"r"});return r.generatedKey;}
    void function updateWeek(required numeric id,required string title,string startDate="",string notes=""){queryExecute("UPDATE training_weeks SET title=:t,start_date=:d,notes=:n WHERE id=:id",{t:trim(arguments.title),d:{value:arguments.startDate,null:!len(arguments.startDate)},n:arguments.notes,id:arguments.id},{datasource:variables.datasource});}
    void function deleteWeek(required numeric id){queryExecute("DELETE FROM training_weeks WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});}
    array function topics(required numeric weekId){var q=queryExecute("SELECT * FROM training_topics WHERE week_id=:id ORDER BY sort_order,id",{id:arguments.weekId},{datasource:variables.datasource});var a=toArray(q);for(var t in a)t.videos=videos(t.id);return a;}
    numeric function createTopic(required numeric weekId,required string title,string lessonPlan="",string keyPoints=""){var r={};var sort=queryExecute("SELECT COALESCE(MAX(sort_order),0)+1 n FROM training_topics WHERE week_id=:id",{id:arguments.weekId},{datasource:variables.datasource}).n[1];queryExecute("INSERT INTO training_topics(week_id,title,lesson_plan,key_points,sort_order) VALUES(:w,:t,:l,:k,:s)",{w:arguments.weekId,t:arguments.title,l:arguments.lessonPlan,k:arguments.keyPoints,s:sort},{datasource:variables.datasource,result:"r"});return r.generatedKey;}
    void function updateTopic(required numeric id,required string title,string lessonPlan="",string keyPoints=""){queryExecute("UPDATE training_topics SET title=:t,lesson_plan=:l,key_points=:k WHERE id=:id",{t:arguments.title,l:arguments.lessonPlan,k:arguments.keyPoints,id:arguments.id},{datasource:variables.datasource});}
    void function deleteTopic(required numeric id){queryExecute("DELETE FROM training_topics WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});}
    array function videos(required numeric topicId){return toArray(queryExecute("SELECT * FROM training_videos WHERE topic_id=:id ORDER BY id",{id:arguments.topicId},{datasource:variables.datasource}));}
    void function addVideo(required numeric topicId,string title="",required string url){queryExecute("INSERT INTO training_videos(topic_id,title,url) VALUES(:id,:t,:u)",{id:arguments.topicId,t:arguments.title,u:arguments.url},{datasource:variables.datasource});}
    void function deleteVideo(required numeric id){queryExecute("DELETE FROM training_videos WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});}
    array function people(){return toArray(queryExecute("SELECT * FROM training_people ORDER BY name",{}, {datasource:variables.datasource}));}
    numeric function addPerson(required string name,string email=""){var r={};queryExecute("INSERT INTO training_people(name,email) VALUES(:n,:e)",{n:trim(arguments.name),e:trim(arguments.email)},{datasource:variables.datasource,result:"r"});return r.generatedKey;}
    void function updatePerson(required numeric id,required string name,string email=""){queryExecute("UPDATE training_people SET name=:n,email=:e WHERE id=:id",{n:arguments.name,e:arguments.email,id:arguments.id},{datasource:variables.datasource});}
    void function deletePerson(required numeric id){queryExecute("DELETE FROM training_people WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});}
    array function sessions(required numeric weekId){var q=queryExecute("SELECT s.*, (SELECT COUNT(*) FROM training_attendance a WHERE a.session_id=s.id AND a.attended=1) attended_count, (SELECT COUNT(*) FROM training_attendance a WHERE a.session_id=s.id AND a.attended=1 AND a.signature IS NOT NULL) signed_count FROM training_sessions s WHERE s.week_id=:id ORDER BY s.session_date,s.id",{id:arguments.weekId},{datasource:variables.datasource});return toArray(q);}
    numeric function createSession(required numeric weekId,required string trainerName,string sessionDate="",string location=""){var r={};queryExecute("INSERT INTO training_sessions(week_id,trainer_name,session_date,location) VALUES(:w,:t,:d,:l)",{w:arguments.weekId,t:arguments.trainerName,d:{value:arguments.sessionDate,null:!len(arguments.sessionDate)},l:arguments.location},{datasource:variables.datasource,result:"r"});seedAttendance(r.generatedKey);return r.generatedKey;}
    void function updateSession(required numeric id,required string trainerName,string sessionDate="",string location=""){queryExecute("UPDATE training_sessions SET trainer_name=:t,session_date=:d,location=:l WHERE id=:id",{t:arguments.trainerName,d:{value:arguments.sessionDate,null:!len(arguments.sessionDate)},l:arguments.location,id:arguments.id},{datasource:variables.datasource});}
    void function deleteSession(required numeric id){queryExecute("DELETE FROM training_sessions WHERE id=:id",{id:arguments.id},{datasource:variables.datasource});}
    void function seedAttendance(required numeric sessionId){queryExecute("INSERT INTO training_attendance(session_id,person_id,attended) SELECT :sid,p.id,0 FROM training_people p WHERE NOT EXISTS(SELECT 1 FROM training_attendance a WHERE a.session_id=:sid2 AND a.person_id=p.id)",{sid:arguments.sessionId,sid2:arguments.sessionId},{datasource:variables.datasource});}
    array function attendance(required numeric sessionId){seedAttendance(arguments.sessionId);var q=queryExecute("SELECT a.*,p.name,p.email FROM training_attendance a JOIN training_people p ON p.id=a.person_id WHERE a.session_id=:id ORDER BY p.name",{id:arguments.sessionId},{datasource:variables.datasource});return toArray(q);}
    void function setAttendance(required numeric sessionId,required numeric personId,required boolean attended){seedAttendance(arguments.sessionId);queryExecute("UPDATE training_attendance SET attended=:a, signature=CASE WHEN :a2=0 THEN NULL ELSE signature END, signed_at=CASE WHEN :a3=0 THEN NULL ELSE signed_at END WHERE session_id=:s AND person_id=:p",{a:arguments.attended?1:0,a2:arguments.attended?1:0,a3:arguments.attended?1:0,s:arguments.sessionId,p:arguments.personId},{datasource:variables.datasource});}
    void function sign(required numeric sessionId,required numeric personId,required string signature){seedAttendance(arguments.sessionId);queryExecute("UPDATE training_attendance SET attended=1,signature=:sig,signed_at=CURRENT_TIMESTAMP WHERE session_id=:s AND person_id=:p",{sig:arguments.signature,s:arguments.sessionId,p:arguments.personId},{datasource:variables.datasource});}
    struct function report(){var stats={weeks:queryExecute("SELECT COUNT(*) c FROM training_weeks",{}, {datasource:variables.datasource}).c[1],people:queryExecute("SELECT COUNT(*) c FROM training_people",{}, {datasource:variables.datasource}).c[1],sessions:queryExecute("SELECT COUNT(*) c FROM training_sessions",{}, {datasource:variables.datasource}).c[1],attended:queryExecute("SELECT COUNT(*) c FROM training_attendance WHERE attended=1",{}, {datasource:variables.datasource}).c[1],signed:queryExecute("SELECT COUNT(*) c FROM training_attendance WHERE attended=1 AND signature IS NOT NULL",{}, {datasource:variables.datasource}).c[1]};stats.weeks_detail=weeks();return stats;}
    private struct function row(required query q,required numeric n){var s={};for(var c in listToArray(q.columnList))s[lCase(c)]=q[c][n];return s;}
    private array function toArray(required query q){var a=[];for(var i=1;i<=q.recordCount;i++)arrayAppend(a,row(q,i));return a;}
}
